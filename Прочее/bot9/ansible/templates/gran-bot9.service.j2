# {{ ansible_managed }}
[Unit]
Description=Бот «{{ bot9_group_name }}» (bot9) для ВКонтакте
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{ bot9_user }}
Group={{ bot9_user }}
WorkingDirectory={{ bot9_dir }}
Environment=PYTHONUNBUFFERED=1
ExecStart={{ bot9_home }}/venv/bin/python {{ bot9_dir }}/bot9_server.py --restart-days {{ bot9_restart_days }}{{ ' --debug' if bot9_debug | bool else '' }}
# «{{ bot9_group_name }}, стоп машина» — бот и сервер выходят с кодом 0, systemd их не поднимает
# (запустить снова: systemctl start {{ bot9_service }}); падение — перезапуск.
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
